{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://satyacheck-ai-digital-evidence.onrender.com/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://satyacheck-ai-digital-evidence.onrender.com/uploads/:match*"
    },
    {
      "source": "/samples/:match*",
      "destination": "https://satyacheck-ai-digital-evidence.onrender.com/samples/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
